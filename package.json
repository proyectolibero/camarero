{
  "name": "camarero",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Garzon virtual para hosteleria: software libre (AGPL-3.0-or-later).",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "prepare": "husky",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "verify": "pnpm check",
    "deploy:api": "pnpm --filter @camarero/api run deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "husky": "^9",
    "lint-staged": "^17",
    "typescript": "^5",
    "wrangler": "^4.142.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,jsonc,md}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
