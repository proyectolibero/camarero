{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "camarero-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 12 * * *"]
  },
  "vars": {
    "VERSION": "0.0.0"
  },
  "r2_buckets": [
    {
      "binding": "CARTAS",
      "bucket_name": "camarero-cartas"
    }
  ],
  "hyperdrive": [
    {
      "binding": "BASE",
      "id": "8d17257eef554341870f06bcfc93376a"
    }
  ]
}
